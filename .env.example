NEXT_PUBLIC_SUPABASE_URL=__SUPABASE_URL__
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=__SUPABASE_PUBLISHABLE_KEY__
SUPABASE_SERVICE_ROLE_KEY=__SUPABASE_SERVICE_ROLE_KEY__
# Hosted beta uses a newer server-only secret key. Legacy local CLI key remains above.
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
# Optional server-only HTTP(S) proxy for OpenAI calls. Direct connection by default.
OPENAI_HTTPS_PROXY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=whisper-1
OPENAI_ASSESSMENT_MODEL=gpt-4.1-mini
# Free mode by default. Explicit server opt-in for paid nuanced evaluation only.
OPENAI_ENHANCED_EVALUATION=false
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Server-only temporary voice retention and scheduling; production Node server runs cleanup.
VOICE_SUCCESS_HOURS=24
VOICE_RETRY_HOURS=72
VOICE_CLEANUP_INTERVAL_SECONDS=3600
VOICE_CLEANUP_ENABLED=true

# Phase 13: Stripe TEST MODE only. Empty means billing unavailable.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_YEARLY_PRICE_ID=
# Hosted checkout does not require a publishable key.
# Manual HTTP cleanup: random server-only secret of at least 32 characters.
# Netlify Scheduled Functions call the shared maintenance service daily.
CRON_SECRET=
# AdSense delivery stays false. A later explicit launch approval is required to enable it.
ADSENSE_DELIVERY_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
ADSENSE_DASHBOARD_SLOT_ID=
ADSENSE_PROGRESS_SLOT_ID=
ADSENSE_SESSION_COMPLETE_SLOT_ID=
ADSENSE_BETWEEN_LEARNING_BLOCKS_SLOT_ID=
