{
  "name": "adaptive-english",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright install chromium && playwright test",
    "test:providers:live": "next build && playwright test --config playwright.live.config.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local",
    "db:types": "supabase gen types typescript --local --schema public > src/types/database.generated.ts",
    "db:status": "supabase status",
    "voice:cleanup": "node --env-file=.env.local --experimental-strip-types scripts/cleanup-worker.ts",
    "voice:worker": "node --env-file=.env.local --experimental-strip-types scripts/cleanup-worker.ts --watch",
    "qa:adaptive": "node scripts/adaptive-quality.mjs",
    "mobile:start": "corepack pnpm --dir apps/mobile start",
    "mobile:android": "corepack pnpm --dir apps/mobile android",
    "mobile:typecheck": "corepack pnpm --dir apps/mobile typecheck",
    "mobile:test": "corepack pnpm --dir apps/mobile test",
    "mobile:lint": "corepack pnpm --dir apps/mobile lint",
    "mobile:check": "corepack pnpm --dir apps/mobile check",
    "mobile:export": "corepack pnpm --dir apps/mobile export"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "stripe": "^22.6.2",
    "undici": "7.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vitest": "5.0.1"
  }
}
